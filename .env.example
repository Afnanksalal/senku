# Copy to .env using scripts/setup.ps1. Never commit real secrets.
POSTGRES_DB=senku
POSTGRES_USER=senku
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
MINIO_ROOT_USER=senku-local
MINIO_ROOT_PASSWORD=REPLACE_WITH_RANDOM_SECRET
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLE_GENAI_USE_VERTEXAI=true

# Reserved alternate key setting. Current integrations use Vertex AI with ADC, not this key.
GEMINI_API_KEY=
# ADC files belong in ignored .secrets/ and must be mounted at runtime.
SCIENCE_TOKEN=REPLACE_WITH_RANDOM_SECRET
OFFLINE_SIGNING_KEY=REPLACE_WITH_RANDOM_SECRET
AUTH_MODE=local
ALLOW_LOCAL_REGISTRATION=true
S3_CREATE_BUCKET=true
ENABLE_GEMINI=false
GEMINI_MODEL=
