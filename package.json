{
  "name": "senku",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w @senku/web\" \"npm run dev -w @senku/api\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format:check": "git diff --check",
    "verify:infra": "node scripts/check-infra.cjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vitest": "5.0.5",
    "@playwright/test": "1.64.1",
    "@axe-core/playwright": "4.14.0",
    "@types/node": "26.6.5",
    "concurrently": "10.0.6"
  },
  "overrides": {
    "multer": "2.5.0",
    "@grpc/grpc-js": "1.14.6",
    "uuid": "11.1.1",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "license": "MIT"
}
